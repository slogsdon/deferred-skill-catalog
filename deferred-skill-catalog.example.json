{
  // Pi:          copy to ~/.pi/agent/deferred-skill-catalog.json, or point
  //              PI_DEFERRED_SKILL_CATALOG_CONFIG at this file.
  // Claude Code: copy to ~/.claude/deferred-skill-catalog.json, or point
  //              CLAUDE_DEFERRED_SKILL_CATALOG_CONFIG at this file.
  // One file can serve both; symlink it into both places.
  //
  // Every key is optional. Omit `roots` for the defaults: Pi searches its own
  // global skill locations (~/.pi/agent/skills and ~/.agents/skills); Claude
  // Code always indexes its own skills and enabled plugins, and treats `roots`
  // as extra directories on top.

  // Searched in order. The first root wins when two roots define the same
  // skill name. ~, $VAR, absolute paths, and paths relative to this file work.
  "roots": [
    "~/.pi/agent/skills",
    "~/.agents/skills",
    "~/.claude/skills", // skills written for another harness
    "/absolute/path/to/a/team-skill-repo"
  ],

  // A bare string blacklists that skill name in every root.
  //
  // The object form scopes name matching to skills whose path contains
  // `pathIncludes` - a plain case-sensitive substring of the absolute path,
  // not a glob. Omit `names` to drop every skill under that path.
  "exclude": [
    "some-skill-you-never-use",
    { "pathIncludes": "/vendor/makerskills/skills/", "names": ["decide", "ingest"] },
    { "pathIncludes": "/archived/skills/" }
  ],

  // Directory names the walk never descends into.
  "skipDirectories": [".git", "node_modules", "dist"],

  // Safety valve for a root that points somewhere huge. 12 is far deeper than
  // any real skill tree.
  "maxDepth": 12,

  // Pi only: replace Pi's static <available_skills> block with a short pointer
  // to search_skills / list_skills. Set false to leave Pi's prompt alone.
  // (Claude Code's equivalent is "skillListingBudgetFraction" in its settings.)
  "stripStaticCatalog": true
}
