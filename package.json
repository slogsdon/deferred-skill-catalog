    "pi-coding-agent",
    "claude-code",
    "claude-code-plugin",
    "skills",
    "agent-skills",
    "mcp"
  ],
  "license": "MIT",
  "author": "Shane Logsdon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slogsdon/deferred-skill-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/slogsdon/deferred-skill-catalog/issues"
  },
  "homepage": "https://github.com/slogsdon/deferred-skill-catalog#readme",
  "files": [
    "extensions",
    "lib",
    "claude",
    "commands",
    ".claude-plugin",
    "deferred-skill-catalog.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
